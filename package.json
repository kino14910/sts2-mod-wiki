{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "sts2-mod-wiki",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:migrate": "node scripts/db-migrate.mjs",
		"gen:thumbs": "python scripts/gen_card_thumbs.py",
		"mod:extract": "python scripts/mod-extract/import_build.py --mod fgo",
		"mod:import": "python scripts/mod-extract/import_build.py",
		"mod:extract-source": "python scripts/mod-extract/extract.py --mod fgo",
		"test:import": "python -m unittest discover -s scripts/mod-extract -p test_*.py",
		"data:audit-vanilla": "python scripts/mod-extract/audit_vanilla.py",
		"db:seed-sql": "node scripts/gen-wiki-seed-sql.mjs",
		"card-seed:refresh": "node --experimental-transform-types scripts/refresh-card-seeds.mjs",
		"mod-wiki:scan": "node --experimental-strip-types scripts/mod-wiki/scan.mjs",
		"mod-wiki:sync": "node --experimental-strip-types scripts/mod-wiki/sync.mjs"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^5.3.0",
		"@inlang/paraglide-js": "^2.29.3",
		"@neoconfetti/svelte": "^2.2.2",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.4.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.11",
		"@types/pg": "^8.23.1",
		"@vitest/browser-playwright": "^4.1.12",
		"playwright": "^1.65.1",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^2.2.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource/cinzel": "^5.3.0",
		"@fontsource/kreon": "^5.3.0",
		"@neon/config": "^1.14.8",
		"@neon/env": "^2.1.11",
		"@vercel/functions": "^3.11.4",
		"pg": "^8.23.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "11.0.5",
		"virtua": "^0.54.2"
	}
}
