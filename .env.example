# Postgres connection string. Use the Neon pooled endpoint on Vercel (Supabase also works).
DATABASE_URL=postgresql://user:password@host:5432/sts2_mod_wiki
# Direct Neon endpoint for schema migrations; scripts fall back to DATABASE_URL when absent.
DATABASE_URL_UNPOOLED=
# Strong random HMAC key for session cookies and invitation-code digests.
WIKI_SESSION_SECRET=replace-with-a-long-random-value
# Local-only convenience login for seeded accounts. Never enable in production.
WIKI_DEV_LOGIN=0
